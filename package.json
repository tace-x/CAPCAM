{
  "name": "capcam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Chrome extension foundation for CapCam.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/copy-extension-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests vite.config.ts vitest.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.11.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
